# Copy this file to `client/.env` and fill in real values.
# `client/.env` is gitignored — never commit real credentials.
#
# IMPORTANT: every variable prefixed with VITE_ is compiled into the JavaScript
# bundle that ships to the browser. Only put values here that are safe to be
# public. Model API keys must live on the server instead — see /.env.example.

# ---- Firebase (web config: public by design) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Cloudinary (unsigned upload preset: public by design) ----
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
